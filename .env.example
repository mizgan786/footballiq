# Copy this file to .env and fill in real values. Never commit .env itself.

# Database. Leave unset / commented to fall back to a local SQLite file
# (backend/footballiq.db) - handy for local dev when Postgres isn't running.
# DATABASE_URL=postgresql://user:password@localhost:5432/footballiq

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider for the AI chatbot
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
